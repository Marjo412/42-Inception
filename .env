# Contains configuration information that is not a password

# Name of the MariaDB database used by WordPress
MYSQL_DATABASE=wordpress

# MariaDB user used by WordPress to access the database
MYSQL_USER=wpuser

# WordPress website URL
WP_URL=https://mrosset.42.fr

# WordPress website title
WP_TITLE=Inception

# WordPress administrator account
WP_ADMIN_USER=mrosset
WP_ADMIN_EMAIL=mrosset@student.42.fr

# Second WordPress user
WP_USER=wpuser
WP_USER_EMAIL=wpuser@mrosset.42.fr